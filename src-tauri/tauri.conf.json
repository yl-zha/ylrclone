{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ylrclone",
  "version": "0.1.0",
  "identifier": "io.github.ylzha.ylrclone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ylrclone",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Mount WebDAV remotes as local drives",
    "longDescription": "ylrclone mounts WebDAV remotes to local drives with rclone and keeps them mounted from the system tray.",
    "category": "Utility",
    "externalBin": ["binary/rclone"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}